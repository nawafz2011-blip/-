<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sheet_bg"
    android:gravity="center_horizontal"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="14dp"
    android:paddingEnd="22dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/pill_bg" />

    <TextView
        android:id="@+id/sheetIcon"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/ok_soft_circle"
        android:gravity="center"
        android:text="🎵"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="هل تريد إزالة الموسيقى من هذا المقطع؟"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sheetText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:text="سيُنقل المقطع إلى تطبيق «عزل» لإزالة الموسيقى، ويبقى الكلام فقط."
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sheetYes"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:text="نعم، أزِل الموسيقى"
        android:textSize="16sp"
        app:backgroundTint="@color/ok"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sheetNo"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="6dp"
        android:text="لا، حمِّل المقطع كما هو"
        android:textColor="@color/text"
        android:textSize="16sp"
        app:backgroundTint="@color/chip"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <TextView
        android:id="@+id/sheetNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="إذا لم يكن تطبيق «عزل» مثبتًا، سيُطلب منك تحميله أولًا."
        android:textColor="@color/muted"
        android:textSize="12sp" />
</LinearLayout>
