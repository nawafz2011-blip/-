<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ==================== التحميل ==================== -->
            <LinearLayout
                android:id="@+id/downloadView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <!-- الشعار -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/logo_bg"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_launcher_foreground" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/app_name"
                        android:textColor="@color/text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/versionPill"
                        style="@style/Pill"
                        android:layout_margin="0dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/updateBanner"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="فيه نسخة جديدة من التطبيق، اضغط للتحديث"
                    android:visibility="gone"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart" />

                <!-- البطاقة الحمراء -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/hero_bg"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hero_title"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.05" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="الصق رابط، أو كذا رابط (كل واحد في سطر)، أو رابط قائمة تشغيل."
                        android:textColor="@color/white_80"
                        android:textSize="14sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/urlLayout"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="https://youtu.be/..."
                        app:boxBackgroundColor="@color/card"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:endIconMode="clear_text"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/urlInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="https://youtu.be/..."
                            android:inputType="textUri|textMultiLine"
                            android:layoutDirection="ltr"
                            android:maxLines="5"
                            android:minHeight="56dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:textDirection="ltr"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/searchBtn"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="2"
                            app:backgroundTint="#FFFFFF"
                            android:text="ابحث"
                            android:textColor="@color/accent"
                            android:textSize="16sp"
                            app:icon="@drawable/ic_search"
                            app:iconGravity="textStart"
                            app:iconTint="@color/accent" />

                        <Space
                            android:layout_width="8dp"
                            android:layout_height="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/pasteBtn"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            app:backgroundTint="@color/white_20"
                            android:text="لصق"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            app:icon="@drawable/ic_paste"
                            app:iconGravity="textStart"
                            app:iconTint="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/muted"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <!-- المواقع المدعومة -->
                <LinearLayout
                    android:id="@+id/sites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView style="@style/Pill" android:text="يوتيوب" />
                        <TextView style="@style/Pill" android:text="تيك توك" />
                        <TextView style="@style/Pill" android:text="إنستقرام" />
                        <TextView style="@style/Pill" android:text="تويتر" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView style="@style/Pill" android:text="فيسبوك" />
                        <TextView style="@style/Pill" android:text="ساوند كلاود" />
                        <TextView style="@style/Pill" android:text="+ مئات المواقع" />
                    </LinearLayout>
                </LinearLayout>

                <!-- فيديو واحد -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/singleCard"
                    style="@style/Card"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/thumb"
                                android:layout_width="match_parent"
                                android:layout_height="190dp"
                                android:background="@color/chip"
                                android:contentDescription="صورة الفيديو"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/Shape.Thumb" />

                            <TextView
                                android:id="@+id/durationBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="8dp"
                                android:background="@drawable/duration_bg"
                                android:paddingStart="8dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="2dp"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/title"
                            style="@style/TitleText"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/subtitle"
                            style="@style/MutedText"
                            android:layout_marginTop="2dp" />

                        <TextView
                            style="@style/SectionText"
                            android:text="اختر الجودة" />

                        <LinearLayout
                            android:id="@+id/options"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <!-- أدوات إضافية -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/trimChip"
                                style="@style/ExtraChip"
                                android:text="قص"
                                app:icon="@drawable/ic_cut" />

                            <Space
                                android:layout_width="6dp"
                                android:layout_height="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/subsChip"
                                style="@style/ExtraChip"
                                android:text="ترجمة"
                                app:icon="@drawable/ic_subtitles" />

                            <Space
                                android:layout_width="6dp"
                                android:layout_height="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/thumbBtn"
                                style="@style/ExtraChip"
                                android:text="الغلاف"
                                app:icon="@drawable/ic_image" />
                        </LinearLayout>

                        <!-- القص -->
                        <LinearLayout
                            android:id="@+id/trimPanel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/panel_bg"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:visibility="gone">

                            <TextView
                                style="@style/MutedText"
                                android:text="اكتب البداية والنهاية (مثل 1:20)، وبعدها اختر الجودة من فوق." />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="من">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/trimStart"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:digits="0123456789:٠١٢٣٤٥٦٧٨٩"
                                        android:inputType="time"
                                        android:textDirection="ltr" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <Space
                                    android:layout_width="8dp"
                                    android:layout_height="1dp" />

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="إلى">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/trimEnd"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:digits="0123456789:٠١٢٣٤٥٦٧٨٩"
                                        android:inputType="time"
                                        android:textDirection="ltr" />
                                </com.google.android.material.textfield.TextInputLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- الترجمة -->
                        <LinearLayout
                            android:id="@+id/subsPanel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/panel_bg"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/subsBlock"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <Spinner
                                    android:id="@+id/subsLang"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp" />

                                <com.google.android.material.button.MaterialButtonToggleGroup
                                    android:id="@+id/subsMode"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    app:checkedButton="@id/subsNone"
                                    app:selectionRequired="true"
                                    app:singleSelection="true">

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/subsNone"
                                        style="@style/Widget.Material3.Button.OutlinedButton"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:paddingStart="2dp"
                                        android:paddingEnd="2dp"
                                        android:text="بدون"
                                        android:textSize="13sp" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/subsEmbed"
                                        style="@style/Widget.Material3.Button.OutlinedButton"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.3"
                                        android:paddingStart="2dp"
                                        android:paddingEnd="2dp"
                                        android:text="مع الفيديو"
                                        android:textSize="13sp" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/subsFile"
                                        style="@style/Widget.Material3.Button.OutlinedButton"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.3"
                                        android:paddingStart="2dp"
                                        android:paddingEnd="2dp"
                                        android:text="منفصل"
                                        android:textSize="13sp" />
                                </com.google.android.material.button.MaterialButtonToggleGroup>

                                <TextView
                                    android:id="@+id/subsHint"
                                    style="@style/MutedText"
                                    android:layout_marginTop="6dp"
                                    android:textSize="13sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/subsBtn"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="حمّل ملف الترجمة (SRT)"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/noSubs"
                                style="@style/MutedText"
                                android:text="ما فيه ترجمة لهذا الفيديو."
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- قائمة تشغيل -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/playlistCard"
                    style="@style/Card"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/icon_circle"
                                android:contentDescription="@null"
                                android:padding="10dp"
                                android:src="@drawable/ic_playlist"
                                app:tint="@color/accent" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/plTitle"
                                    style="@style/TitleText" />

                                <TextView
                                    android:id="@+id/plSub"
                                    style="@style/MutedText" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/panel_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp">

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/plAll"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="الكل" />

                            <Spinner
                                android:id="@+id/plQuality"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/plGo"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="10dp"
                            android:text="حمّل المحدد"
                            app:icon="@drawable/ic_download"
                            app:iconGravity="textStart" />

                        <LinearLayout
                            android:id="@+id/plList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- كذا رابط -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/batchCard"
                    style="@style/Card"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/batchTitle"
                            style="@style/TitleText" />

                        <TextView
                            style="@style/MutedText"
                            android:text="بتنزل ورا بعض، وتقدر تتابعها تحت." />

                        <Spinner
                            android:id="@+id/batchQuality"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/panel_bg" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/batchGo"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="10dp"
                            android:text="حمّل الكل"
                            app:icon="@drawable/ic_download"
                            app:iconGravity="textStart" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- التحميلات -->
                <LinearLayout
                    android:id="@+id/queueHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="التحميلات"
                        android:textColor="@color/text"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clearDone"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مسح المنتهية"
                        android:textColor="@color/muted" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/jobsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/footer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="حمّل المحتوى اللي تملكه أو المسموح بتحميله فقط."
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ==================== السجل ==================== -->
            <LinearLayout
                android:id="@+id/historyView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="سجل التحميلات"
                        android:textColor="@color/text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clearHistory"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مسح السجل"
                        android:textColor="@color/muted" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/historyEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="80dp">

                    <ImageView
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:background="@drawable/icon_circle"
                        android:contentDescription="@null"
                        android:padding="22dp"
                        android:src="@drawable/ic_history"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="لسا ما حمّلت شيء"
                        android:textColor="@color/text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="أول ما تحمّل فيديو، بيطلع هنا."
                        android:textColor="@color/muted" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/historyList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ==================== المتصفح ==================== -->
    <LinearLayout
        android:id="@+id/browserView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- شريط العنوان -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/webHome"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="الصفحة الرئيسية"
                app:icon="@drawable/ic_home"
                app:iconTint="@color/muted" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.FilledBox.Dense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:boxBackgroundColor="@color/chip"
                app:boxCornerRadiusBottomEnd="22dp"
                app:boxCornerRadiusBottomStart="22dp"
                app:boxCornerRadiusTopEnd="22dp"
                app:boxCornerRadiusTopStart="22dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/webAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="ابحث أو اكتب رابط"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textDirection="locale"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/webReload"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="تحديث"
                app:icon="@drawable/ic_refresh"
                app:iconTint="@color/muted" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/webProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_track"
            android:progressTint="@color/accent"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- الصفحة الأولى: اختصارات المواقع -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/webStart"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="المتصفح"
                        android:textColor="@color/text"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/MutedText"
                        android:layout_marginTop="4dp"
                        android:text="افتح الموقع، وشغّل الفيديو اللي تبيه، وبعدها اضغط زر (حمّل) تحت." />

                    <GridLayout
                        android:id="@+id/webShortcuts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:columnCount="3"
                        android:useDefaultMargins="false" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- هنا ينحط المتصفح نفسه (WebView) من الكود -->
            <FrameLayout
                android:id="@+id/webContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/webDownload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="14dp"
                android:text="حمّل هذا الفيديو"
                android:textColor="#FFFFFF"
                android:visibility="gone"
                app:backgroundTint="@color/accent"
                app:icon="@drawable/ic_download"
                app:iconTint="#FFFFFF" />
        </FrameLayout>

        <!-- رجوع وتقدّم -->
        <LinearLayout
            android:id="@+id/webNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/webBack"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:contentDescription="رجوع"
                app:icon="@drawable/ic_arrow_back"
                app:iconGravity="textStart"
                app:iconTint="@color/muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/webForward"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:contentDescription="تقدّم"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textStart"
                app:iconTint="@color/muted" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backgroundTint="@color/card"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@style/NavIndicator"
        app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
